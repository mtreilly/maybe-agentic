{
  "name": "@local/dsh-maybe-agentic-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Setup health for the maybe-agentic skill manifest and MCP servers, shown as a Plugins settings tab, with a design jig for its primitives.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
